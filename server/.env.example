# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=realestate

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AI property assistant (optional).
# Without a key the summary falls back to a deterministic template and the
# follow-up chat returns 503. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
